# Copy to ~/.config/v-cropper/provider.env, replace values, then `chmod 600` the file.
# Do not commit the resulting provider.env. brev/**/*.env is gitignored.
#
# On a Brev Launchable, setup.sh writes this file from Launch parameters on first boot.
# It exists so the stack can be restarted later: Brev does not re-supply launch
# parameters to subsequent container runs.

# --- caller authentication ----------------------------------------------------------
# Required bootstrap admin token. Clients send `Authorization: Bearer <this>`.
# Mint per-client keys at POST /v1/admin/keys; this value cannot be revoked via the API.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CROPPER_API_TOKEN=

# --- model provider: OpenAI-compatible (default) ------------------------------------
VCROPPER_PROVIDER=openai
VCROPPER_BASE_URL=https://integrate.api.nvidia.com/v1
VCROPPER_API_KEY=
# Optional; omit to use the provider default model.
VCROPPER_MODEL=

# --- object-store allowlist (job source/destination URLs) -----------------------------
# Compose defaults to minio,host.docker.internal. For Amazon S3 add the regional
# wildcard, e.g. *.s3.us-west-2.amazonaws.com,*.amazonaws.com
# CROPPER_ALLOWED_HOSTS=minio,host.docker.internal
# Compose defaults this to true so Docker-network MinIO (verify) works. Set false for
# public object stores. setup.sh persists this when supplied as a Launch parameter.
# CROPPER_ALLOW_PRIVATE_HOSTS=false

# --- model provider: AWS Bedrock (alternative) --------------------------------------
# Set VCROPPER_PROVIDER=bedrock and a region. Credentials come from the standard boto3
# chain, so an instance role is preferred over static keys.
# VCROPPER_PROVIDER=bedrock
# BEDROCK_REGION=us-east-1
# BEDROCK_VLM_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
