# --- VLM provider (OpenAI-compatible default, or native AWS Bedrock) ---
# VCROPPER_PROVIDER=openai
# OpenAI-compatible mode requires an API key. Endpoint + model default to NVIDIA.
VCROPPER_API_KEY=
# Override the endpoint + model to target a different provider, e.g.:
#   OpenAI:      VCROPPER_BASE_URL=https://api.openai.com/v1           VCROPPER_MODEL=gpt-4o
#   OpenRouter:  VCROPPER_BASE_URL=https://openrouter.ai/api/v1        VCROPPER_MODEL=...
#   Gemini:      VCROPPER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  VCROPPER_MODEL=gemini-2.5-flash
# VCROPPER_BASE_URL=
# VCROPPER_MODEL=
# Per-request timeout in seconds (default 120).
# VCROPPER_TIMEOUT=120
# Force structured JSON output if the provider supports it (e.g. json_object).
# VCROPPER_RESPONSE_FORMAT=
# Cap completion tokens per call (the point reply is tiny; default 200 in-code).
# VCROPPER_MAX_TOKENS=
# Extra JSON merged into each request body. Gemini defaults to disabling "thinking"
# ({"reasoning_effort":"none"}); override here for other providers if needed.
# VCROPPER_EXTRA_BODY=
# Extra HTTP headers for an OpenAI-compatible gateway, as a JSON object of string values.
# Header values can be sensitive; never commit this setting in a real .env file.
# VCROPPER_EXTRA_HEADERS={"X-Gateway-Client":"v-cropper"}

# Native Bedrock Converse mode. AWS credentials use boto3's standard credential
# chain (environment, shared config/profile, container/task role, or instance role).
# VCROPPER_PROVIDER=bedrock
# BEDROCK_REGION=us-east-1
# AWS_REGION=us-east-1
# Optional static/session credentials (prefer workload roles in production):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Model precedence: --model, VCROPPER_MODEL, BEDROCK_VLM_MODEL_ID, then the
# built-in global Claude Sonnet inference-profile fallback.
# BEDROCK_VLM_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Back-compat: existing GEMINI_API_KEY still works ---
# If only GEMINI_API_KEY is set (no VCROPPER_BASE_URL), the connector routes to
# Gemini's OpenAI-compatible endpoint with gemini-2.5-flash automatically.
# GEMINI_API_KEY=

# --- Action tracking (sport / pointing prompt). CLI flags override these. ---
# Sport preset for the pointing prompt (default football). Built-in presets:
# football, basketball, soccer, hockey, general.
# VCROPPER_SPORT=football
# Inline pointing prompt (overrides VCROPPER_SPORT). Must ask for {"x":..,"y":..} 0-1000.
# VCROPPER_PROMPT=
# Read the pointing prompt from a file (overrides VCROPPER_SPORT).
# VCROPPER_PROMPT_FILE=
# Downscale width (px) of the frame sent to the VLM (default 768).
# VCROPPER_SEND_WIDTH=768
# Spring smoothing stiffness; lower = smoother pan (default in-code).
# VCROPPER_SPRING_K=

# --- Cost estimate ($/1M tokens) for the informational metrics line ---
# VCROPPER_PRICE_IN=0.30
# VCROPPER_PRICE_OUT=2.50

# --- Scoreboard overlay (optional). CLI flags override these. ---
# SCOREBOARD_ENABLED=false
# SCOREBOARD_SAMPLE_COUNT=10
# SCOREBOARD_MODEL=
# SCOREBOARD_POSITION=bottom
# SCOREBOARD_HEIGHT_RATIO=0.16
# SCOREBOARD_OPACITY=0.85

# --- Async crop-job service ---
# REQUIRED bootstrap admin token. Callers send `Authorization: Bearer <this>` on /v1
# routes; health endpoints stay open. Mint per-client keys at POST /v1/admin/keys so
# you can revoke one without rotating this. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# CROPPER_API_TOKEN=
# Host interface for the published port. Loopback-only by default. Local Compose talks to
# 127.0.0.1 directly; a Brev VM is reached over SSH (`ssh -N -L` or `brev port-forward`).
# A non-loopback bind is refused unless you also set CROPPER_ALLOW_PLAINTEXT=1 —
# otherwise the bearer token travels in the clear.
# CROPPER_BIND_ADDRESS=127.0.0.1
# CROPPER_PUBLISHED_PORT=8090
# CROPPER_ALLOW_PLAINTEXT=
# Operator declaration of how callers actually reach the service. Empty = undeclared
# (the default: loopback behind a tunnel). Set to https://… when TLS terminates in front.
# CROPPER_PUBLIC_ORIGIN=
# Redis queue/state database. Standalone Compose uses DB 1.
# CROPPER_REDIS_URL=redis://redis:6379/1
# Comma-separated exact hosts or *.suffix wildcards accepted for presigned URLs.
# Compose defaults to minio,host.docker.internal. For Amazon S3 add e.g.
# *.s3.us-west-2.amazonaws.com,*.amazonaws.com
# CROPPER_ALLOWED_HOSTS=minio,host.docker.internal
# Compose defaults this to true so Docker-network MinIO (verify) works. Set false for
# public object stores unless the allowlisted store is on a trusted private network.
# CROPPER_ALLOW_PRIVATE_HOSTS=false
# CROPPER_JOB_TTL_SEC=86400
# CROPPER_MAX_DURATION_SEC=900
# CROPPER_MAX_OUTPUT_BYTES=2000000000
# CROPPER_HTTP_TIMEOUT_SEC=300
# CROPPER_PORT=8080
